# ==============================================================================
# M&A Due Diligence Intelligence Engine — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- LLM API Keys ---
# Free-tier Gemini quotas are per API key, so adding keys multiplies capacity.
# The engine drains one key's quota on a given model before moving to the next
# key on the SAME model, and only steps down to a weaker model once every key is
# spent — so answer quality degrades last, not first.
#
# Use any one of these three forms (checked in this order):
GEMINI_API_KEYS=key_one,key_two,key_three
# GEMINI_API_KEY_1=key_one
# GEMINI_API_KEY_2=key_two
# GEMINI_API_KEY=your_gemini_api_key_here      # single-key / legacy
#
# Order matters: key 1 is spent first. With no key set, every agent runs on the
# local Ollama model and the pipeline still works.
#
# ONE KEY PER GOOGLE CLOUD PROJECT. The free-tier quota belongs to the project,
# not the key: two keys from the same project share one quota, and listing both
# only makes the engine plan for capacity that does not exist. Remove a key that
# answers 401 instead of leaving it to be retried after every restart.

# --- Verification agents (Agents 4 and 8) ---
# "cloud" (default) routes verification through the Gemini ladder — better
# structured reasoning, and no local GPU needed. "local" pins it to Ollama,
# which keeps verification off the metered quota entirely.
VERIFICATION_BACKEND=cloud

# --- Database ---
POSTGRES_URL=postgresql://manda_user:your_password_here@localhost:5432/manda_rag
POSTGRES_PASSWORD=your_password_here

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_GRPC_PORT=6334
# "server" (default) fails startup when QDRANT_URL is unreachable. "local" is an
# embedded on-disk index for development without Docker (single process, no
# HNSW); it is never selected automatically.
# QDRANT_MODE=local
# QDRANT_LOCAL_PATH=./qdrant_local_db

# --- Ollama (Local LLM Fallback) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=60m
OLLAMA_NUM_GPU=1

# --- Application Settings ---
LOG_LEVEL=INFO
ENVIRONMENT=development

# Directory for the immutable audit log (every query and ingestion is recorded).
AUDIT_LOG_DIR=./logs/audit

# --- Public demo guardrails (api/security.py) ---
# Admin key, sent as the X-Admin-Key header. Lifts every limit and is required to
# delete or write non-sandbox deals. Unset: admin is implied only when
# ENVIRONMENT=development (so the local UI and eval harness keep working).
# ADMIN_API_KEY=
# Take the client IP from X-Forwarded-For's first hop. Only set behind a proxy.
TRUST_PROXY_HEADERS=0
# Per-client-IP query limits (/query and /query/stream). 0 disables a limit.
RATE_LIMIT_QUERY_PER_MINUTE=5
RATE_LIMIT_QUERY_PER_DAY=50
# Per-client-IP upload limits (/ingest). 0 disables a limit.
RATE_LIMIT_INGEST_PER_MINUTE=3
RATE_LIMIT_INGEST_PER_DAY=20
# Pipeline runs allowed at once; extra requests get an immediate 503, not a queue.
MAX_CONCURRENT_PIPELINES=2
# Queries per UTC day across all public callers — last-resort Gemini quota guard.
DAILY_QUERY_CAP=300
# Per-client-IP limits on sandbox creation and on reads (deal listings,
# documents, risk signals, purges, /budget). 0 disables a limit.
RATE_LIMIT_DEAL_PER_MINUTE=10
RATE_LIMIT_DEAL_PER_DAY=100
RATE_LIMIT_READ_PER_MINUTE=120
# Deals anonymous callers may read and query (comma-separated). Anything else
# needs the admin key; a visitor's own sandbox deals are always readable.
PUBLIC_DEAL_IDS=aurora_vertex_2024
# Request body caps: uploads (MB), every other body (KB), and how far an office
# file (.docx/.xlsx/.pptx) may expand when unzipped (MB).
MAX_UPLOAD_MB=25
MAX_JSON_BODY_KB=64
MAX_EXPANDED_MB=300
# In-memory sandbox registry ceiling; past it, new sandboxes get a 503.
MAX_REGISTERED_DEALS=2000

# --- Serving (api/main.py, run_api.py, src/workflow/orchestrator.py) ---
# Deadline for one pipeline run, seconds (0 = none). Default 900; when
# SYNTHESIS_MODEL_PIN is set and this is unset, it stretches to cover the pin's
# own wait.
# QUERY_TIMEOUT_SECONDS=900
# Ceiling for a single graph step, seconds (0 = none, the default).
# NODE_TIMEOUT_SECONDS=0
# Comment frames on an idle /query/stream, seconds (0 = never).
SSE_HEARTBEAT_SECONDS=15
# On SIGTERM: seconds in-flight requests get before they are cancelled.
SHUTDOWN_GRACE_SECONDS=25
# Refuse to start if the Postgres checkpointer cannot be used, instead of
# falling back to in-memory checkpoints (reported as degraded either way).
REQUIRE_DURABLE_CHECKPOINTS=0
# Seconds to wait for Postgres at startup before giving up on it.
CHECKPOINTER_CONNECT_TIMEOUT_SECONDS=15
# Checkpoints of completed runs are deleted; failed runs keep theirs this long.
CHECKPOINT_TTL_SECONDS=86400
CHECKPOINT_SWEEP_INTERVAL_SECONDS=3600
# Keep completed runs' checkpoints too (debugging only).
CHECKPOINT_KEEP_COMPLETED=0
# The API keeps its limits in process memory and runs as ONE worker; a worker
# count above one is refused unless this is set (and then reported as degraded).
ALLOW_MULTIPLE_WORKERS=0
# /metrics and the /ready detail need the admin key unless this is set (only on
# a private network).
METRICS_PUBLIC=0

# --- Decision model (src/decisions, Laya) ---
# Local typed yes/no and choice judgments (answerability gate, query guard, risk
# signals, PII, document category). LAYA_ENABLED=0 falls back to the rule-based
# paths everywhere. LAYA_DEVICE defaults to CUDA when available.
LAYA_ENABLED=1
# LAYA_DEVICE=cpu
# Per-decision switches (each falls back to the rule-based path when off):
# risk signals — regex + Laya hybrid; "auto" = union on CUDA, confirm-only on CPU
LAYA_RISK=1
LAYA_RISK_MODE=auto
# document category — Laya decides, filename/keyword rules as fallback
LAYA_CATEGORY=1
# PII — off: on the labelled set Laya lowered precision and hid a chunk the
# golden QA set needs (eval/decisions/results.md)
LAYA_PII=0
# answerability gate — vetoes admission when no passage states the answer.
# ~60 ms on GPU; ~7-30 s per query on 2 CPU cores (off in docker-compose.prod.yml)
LAYA_GATE=1
# public query guard — blocks off-topic / jailbreak prompts before any LLM call
LAYA_QUERY_GUARD=1

# --- Answer verification (src/verification) ---
# Local claim-level grounding model. Unset: FactCG-DeBERTa-v3-Large on GPU (fp16;
# NLI_FP16=0 runs it in fp32), cross-encoder/nli-deberta-v3-xsmall on CPU. If the
# GPU checker cannot load, nli-deberta-v3-small is used and /health reports it.
# Each model has its own calibrated thresholds (src/verification/claim_checker.py).
# VERIFY_NLI=0 skips the stage (the LLM judge covers every claim).
# NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
VERIFY_NLI=1
# Optional tracing of every LLM call (free Langfuse hobby tier or self-hosted).
# Needs `pip install langfuse`; a no-op while these are unset.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Base URL the Streamlit UI uses to reach the API. docker-compose injects
# http://api:8000 (the service DNS name); leave unset for a bare-metal run and
# it defaults to localhost.
# API_URL=http://localhost:8000
