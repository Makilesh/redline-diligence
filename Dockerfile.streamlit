# Dockerfile for Streamlit UI
FROM python:3.11-slim

WORKDIR /app

# The console's packages at the exact versions CI tests (constraints.txt, generated by
# scripts/update_constraints.py), as wheels only — the same way Dockerfile.hf installs the API.
COPY requirements-ui.txt constraints.txt ./
RUN pip install --no-cache-dir --only-binary :all: -c constraints.txt -r requirements-ui.txt

# curl is used by the compose healthcheck
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Copy application code and theme. .streamlit/ must land at the working
# directory Streamlit is launched from, or the theme is silently ignored.
COPY app/ ./app/
COPY .streamlit/ ./.streamlit/
# The console imports src.utils.admin_client (the admin key header) and nothing
# else of src/. Without it every page failed with "No module named 'src'" while
# the health check still passed (tests/test_streamlit_image.py).
COPY src/__init__.py ./src/__init__.py
COPY src/utils/__init__.py src/utils/admin_client.py ./src/utils/

# Expose port
EXPOSE 8501

# Run Streamlit
CMD ["streamlit", "run", "app/streamlit_app.py", "--server.port", "8501", "--server.address", "0.0.0.0", "--server.headless", "true"]
